# What `eas build` leaves out of the uploaded archive (it uploads the repo root).
# When this file exists EAS ignores every .gitignore, so all of their patterns are
# repeated here, plus folders the mobile build never needs.

# ── From .gitignore (root) ─────────────────────────────────────────────────────
.git/
node_modules/
dist/
.expo/
web-build/
coverage/
*.tsbuildinfo
.DS_Store
.vscode/
.idea/
.vercel

# Secrets and signing files — never upload
.env
.env.*
!.env.example
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.orig.*
google-play-service-account.json

# ── From apps/mobile/.gitignore ────────────────────────────────────────────────
# Native projects are regenerated by prebuild on EAS (CNG). The local android/
# folder (emulator dev build, ~1.7 GB with Gradle output) must not be uploaded.
apps/mobile/android/
apps/mobile/ios/
apps/mobile/expo-env.d.ts

# ── From apps/api and apps/web .gitignore ──────────────────────────────────────
apps/api/generated/
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts

# ── Not needed to build the app (workspace package.json files stay for npm) ───
apps/mobile/store/
.claude/
checklists/
