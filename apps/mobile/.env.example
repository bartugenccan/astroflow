# AstroFlow - mobil ortam degiskenleri
# EXPO_PUBLIC_ onekli degiskenler istemci paketine GOMULUR: gizli deger koyma.

# API taban adresi (ortama gore degisir).
# preview/production build: EAS ortam degiskeni olarak verilir, release build https ister:
#   eas env:create --environment production --name EXPO_PUBLIC_API_URL --value https://api.example.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Gizlilik / sartlar / destek sayfalarinin oldugu site (apps/web). Profil linkleri buraya gider.
EXPO_PUBLIC_SITE_URL=https://getastroflow.com

# Beta: true iken herkes Premium. Lansmanda production icin false.
EXPO_PUBLIC_PREMIUM_BETA=true

# RevenueCat public SDK anahtarlari (public olmalari beklenir)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Ortam adi (Sentry environment). eas.json profilleri set eder.
EXPO_PUBLIC_APP_ENV=development

# Sentry DSN (public). Bos ise Sentry kapali; __DEV__ derlemelerde her zaman kapali.
EXPO_PUBLIC_SENTRY_DSN=
# Source map yuklemesi icin EAS ortam degiskenleri (gizli, buraya DEGER YAZMA):
#   SENTRY_AUTH_TOKEN (secret), SENTRY_ORG, SENTRY_PROJECT=astroflow-mobile

# PostHog (public)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Sign-In (optional; the button hides until configured).
# Web client id = the ID-token audience the API checks (GOOGLE_CLIENT_IDS there).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS: client id + its reversed form as URL scheme (com.googleusercontent.apps....).
# The scheme is read by app.config.js at build time (set it as an EAS env var).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
