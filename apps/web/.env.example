# Public origin of this site (canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://astroflow-web.vercel.app
# AstroFlow API base. When empty the waitlist form falls back to a mailto link.
NEXT_PUBLIC_API_URL=
# Support / company contact shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=astroflowhq@gmail.com
# App Store product page (e.g. https://apps.apple.com/app/id6835863763). Empty = waitlist mode; /get and /s fall back to it.
NEXT_PUBLIC_APP_STORE_URL=
# App Store Connect provider token (App Analytics > Campaigns, the pt= value) so /get?c=... campaigns are counted.
NEXT_PUBLIC_APP_STORE_PT=
