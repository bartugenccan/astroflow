# Server. NODE_ENV is required (development | test | production); Docker sets production.
NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astroflow

# Device token signing key — required, at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_DEVICE_SECRET=

# Edge. CORS_ORIGINS: comma-separated web origins allowed to call the API
# (the mobile app needs none). TRUST_PROXY: hop count of proxies in front of the API.
# PRODUCTION: set TRUST_PROXY=1 behind Railway/Render/Fly or any LB; with 0 every
# client shares the proxy IP and the 5/min auth limit applies to all users at once.
# Numbers only — `true` would trust any client-sent X-Forwarded-For.
CORS_ORIGINS=
TRUST_PROXY=0
# Dev only: accept the raw x-device-id header from builds without device tokens.
ALLOW_LEGACY_DEVICE_HEADER=false
# Dev only: POST /astrology/unlock grants features without payment. Never in production.
ENABLE_STUB_UNLOCK=false

# Which vendor serves AI text: anthropic (default) | deepseek
AI_PROVIDER=anthropic
# Claude. Leave blank to use templated fallback interpretations in dev.
# Spend is capped in the Claude Console.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) or claude-haiku-4-5 (cheapest/fastest)
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth on Opus/Sonnet: low | medium | high. Short readings do well on low.
ANTHROPIC_EFFORT=low

# DeepSeek (alternative; used only when AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
# Model tier: deepseek-flash (cheap/fast) or deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# Hidden reasoning. Keep "disabled": with it on, the short token budgets are
# spent on reasoning and responses come back empty.
DEEPSEEK_THINKING=disabled

# Cost guards. AI calls that miss the cache count against these per UTC day.
AI_DAILY_PER_DEVICE=300
AI_DAILY_GLOBAL=20000
# With AI_PROVIDER=deepseek, new AI generation pauses when the prepaid balance drops below this.
DEEPSEEK_MIN_BALANCE=0.2
REPORTS_DAILY_PER_DEVICE=3

# Beta: true = everyone Premium. Defaults to false when unset; set false (or omit) at launch.
PREMIUM_BETA=true

# Sentry (error reporting). Empty DSN = off. Only 5xx errors are sent; request
# bodies, auth headers, user and IP are stripped (src/instrument.ts).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Accounts (optional sign-in on top of anonymous installs). Each provider is
# off until configured; its route then answers 503.
# Sign in with Apple: verification needs only the bundle id. Token exchange and
# revocation on account deletion (App Store requirement) need the SIWA key (.p8).
APPLE_BUNDLE_ID=com.astroflow.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 contents on one line with \n escapes
APPLE_PRIVATE_KEY=
# Google: comma-separated OAuth client ids accepted as ID-token audience (web, iOS, Android).
GOOGLE_CLIENT_IDS=
# Email sign-in codes via Resend (verified domain required for AUTH_EMAIL_FROM).
RESEND_API_KEY=
AUTH_EMAIL_FROM=AstroFlow <login@example.com>
# Seals stored provider secrets (Apple refresh tokens). Long random string: openssl rand -base64 48
# Required (boot fails without it) once APPLE_PRIVATE_KEY is set.
AUTH_ENCRYPTION_KEY=
# Dev only: print sign-in codes to the log instead of (or as well as) emailing them.
AUTH_EMAIL_DEV_LOG=false
