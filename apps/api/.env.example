# Server
NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astroflow

# Auth — both secrets are required, at least 32 characters, and must differ.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_DEVICE_SECRET=

# Edge. CORS_ORIGINS: comma-separated web origins allowed to call the API
# (the mobile app needs none). TRUST_PROXY: hop count when behind a load balancer.
CORS_ORIGINS=
TRUST_PROXY=false
# Dev only: accept the raw x-device-id header from builds without device tokens.
ALLOW_LEGACY_DEVICE_HEADER=false

# Background workers (streak scheduler) require Redis. Off by default.
ENABLE_WORKERS=false
# REDIS_URL=redis://localhost:6379

# DeepSeek AI (leave blank to use templated fallback interpretations in dev)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
# Model tier: deepseek-flash (cheap/fast) or deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# Hidden reasoning. Keep "disabled": with it on, the short token budgets are
# spent on reasoning and responses come back empty.
DEEPSEEK_THINKING=disabled

# Cost guards. AI calls that miss the cache count against these per UTC day.
AI_DAILY_PER_DEVICE=300
AI_DAILY_GLOBAL=20000
# New AI generation pauses when the prepaid DeepSeek balance drops below this.
DEEPSEEK_MIN_BALANCE=0.2
REPORTS_DAILY_PER_DEVICE=3

# Everyone gets Premium until real payments ship.
PREMIUM_BETA=true
