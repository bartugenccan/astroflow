generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──── Enums ──────────────────────────────────────────────────────────────────

enum EnergyState {
  HARMONY
  MOMENTUM
  STRESS
  OVERLOAD
}

enum RitualType {
  WATER_PROGRAMMING
  KINETIC_SYNC
  BREATHWORK
  GROUNDING
  LIGHT_EXPOSURE
  FREQUENCY_TUNING
}

enum SynergyLevel {
  ALPHA
  BETA
  GAMMA
  DELTA
  OMEGA
}

enum FeatureType {
  TRANSIT_CHART
  COMPATIBILITY
  DEEP_INSIGHT
  PREMIUM_RITUAL
  ADVANCED_CYMATICS
}

enum InterpretationKind {
  PLACEMENT
  BIG_THREE
  ASPECT
  OVERVIEW
  DAILY_INSIGHT
  HOUSE
  NODES
  CHART_CONTEXT
  TRANSIT
  TRANSIT_OVERVIEW
  COMPATIBILITY
  FORECAST_WEEKLY
  FORECAST_MONTHLY
  GUIDANCE
  INTENTION_AFFIRMATION
  YEAR_AHEAD
  TAROT_CARD
  TAROT_SYNTHESIS
  ELECTION_CHECK
  ELECTION_SEARCH
  REPORT_NATAL_EXTRAS
  TRANSIT_SPOTLIGHT
  TRANSIT_QUARTER
}

// ──── Core Models ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String
  displayName   String
  avatarUrl     String?
  timezone      String    @default("Europe/Istanbul")
  starPoints    Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  birthProfile    BirthProfile?
  streaks         UserStreak[]
  ritualLogs      RitualLog[]
  unlockedFeatures UnlockedFeature[]

  @@map("users")
}

model BirthProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid

  birthDate    DateTime @db.Date
  birthTime    String
  latitude     Float
  longitude    Float

  sunSign      String
  moonSign     String
  risingSign   String
  risingDegree Float
  dominantElement String?
  dominantPlanet  String?

  chartData    Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("birth_profiles")
}

model UserStreak {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  ritualType      RitualType

  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  DateTime @db.Date
  totalCompletions Int     @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ritualType])
  @@map("user_streaks")
}

model RitualLog {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  ritualType   RitualType
  completedAt  DateTime   @default(now())
  frequencyBoost Int      @default(0)
  durationMinutes Int     @default(0)
  notes        String?

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("ritual_logs")
}

model FrequencyScore {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @unique @db.Uuid

  value        Int         @default(0)
  trend        String      @default("stable")
  synergyLevel SynergyLevel @default(ALPHA)

  breakdown    Json?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("frequency_scores")
}

model DailyAction {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid

  title          String
  description    String
  ritualType     RitualType
  energyCost     Int       @default(0)
  frequencyBoost Int       @default(0)
  durationMinutes Int      @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime?

  generatedAt    DateTime  @default(now())
  expiresAt      DateTime

  @@index([userId, completed, expiresAt])
  @@map("daily_actions")
}

model UnlockedFeature {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  featureType FeatureType
  unlockedAt  DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureType])
  @@map("unlocked_features")
}

// ──── Anonymous (device-ID) chart + AI interpretation cache ──────────────────

model DeviceChart {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String   @unique

  birthDate   String
  birthTime   String
  latitude    Float
  longitude   Float
  utcOffsetMin Int?
  unknownTime Boolean  @default(false)

  sunSign     String
  moonSign    String
  risingSign  String
  chartData   Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("device_charts")
}

model Interpretation {
  id         String             @id @default(uuid()) @db.Uuid
  cacheKey   String             @unique
  kind       InterpretationKind
  locale     String
  content    Json
  model      String?
  /// Set when the cached reading is specific to one device (tarot, daily insight,
  /// guidance) so deleting that device's data can delete it too.
  deviceId   String?

  createdAt  DateTime           @default(now())

  @@index([kind, locale])
  @@index([deviceId])
  @@map("interpretations")
}

// Device-scoped entitlement mirror of UnlockedFeature. The anonymous flow has no
// User, so per-report unlocks (e.g. COMPATIBILITY) are keyed by deviceId instead.
model DeviceUnlockedFeature {
  id          String      @id @default(uuid()) @db.Uuid
  deviceId    String
  featureType FeatureType
  unlockedAt  DateTime    @default(now())

  @@unique([deviceId, featureType])
  @@index([deviceId])
  @@map("device_unlocked_features")
}

// ──── Companion: memory + conversation ───────────────────────────────────────

// Device-scoped memory of what the user tells us, so every surface feels
// continuous ("last week work was heavy…"). Read as a compact digest into prompts.
model MemoryEntry {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String
  kind      String   // 'chat' | 'checkin' | 'topic' | 'goal' | 'fact'
  text      String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
  @@map("memory_entries")
}

// Conversational companion turns (device-scoped, anonymous).
model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String
  role      String   // 'user' | 'assistant'
  content   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
  @@map("chat_messages")
}

// ──── Intentions: chart-guided daily practice ────────────────────────────────

model Intention {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String

  goalText    String
  category    String
  lifeArea    String   // 'love' | 'career' | 'money' | 'energy'
  affirmation String
  dailyTarget Int      @default(1)
  status      String   @default("active") // 'active' | 'archived'

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checkIns    IntentionCheckIn[]
  streak      IntentionStreak?

  @@index([deviceId])
  @@map("intentions")
}

model IntentionCheckIn {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String
  intentionId String   @db.Uuid

  date        String   // YYYY-MM-DD
  conviction  Int
  userText    String?
  inputMode   String   @default("text") // 'text' | 'voice'  (voice-ready)
  transcript  String?
  aiResponse  String
  aiConviction Int?

  createdAt   DateTime @default(now())

  intention   Intention @relation(fields: [intentionId], references: [id], onDelete: Cascade)

  @@index([intentionId, date])
  @@map("intention_check_ins")
}

model IntentionStreak {
  id             String   @id @default(uuid()) @db.Uuid
  deviceId       String
  intentionId    String   @unique @db.Uuid

  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String? // YYYY-MM-DD
  totalCheckIns  Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  intention      Intention @relation(fields: [intentionId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("intention_streaks")
}

// A second person a device has entered for compatibility checks. Big-three is
// denormalized so the list renders without recomputing the chart.
model SavedPerson {
  id           String   @id @default(uuid()) @db.Uuid
  deviceId     String

  label        String
  relationship String?

  birthDate    String
  birthTime    String
  latitude     Float
  longitude    Float
  unknownTime  Boolean  @default(false)
  placeName    String?

  sunSign      String
  moonSign     String
  risingSign   String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([deviceId, createdAt])
  @@map("saved_people")
}

// ─── Device identity & cost guards ───────────────────────────────────────────

/// An anonymous install. The device id is issued (or, once, claimed) by
/// POST /auth/device and only ever travels inside a signed device token.
model DeviceIdentity {
  deviceId  String    @id
  createdAt DateTime  @default(now())
  /// Set when the device's data is deleted — its token stops working.
  revokedAt DateTime?

  @@map("device_identities")
}

/// AI generations that missed the cache, per UTC day. `deviceId = "*"` is the
/// system-wide counter. Backs the daily per-device and global AI budgets.
model AiUsage {
  day      String // "YYYY-MM-DD" (UTC)
  deviceId String
  count    Int    @default(0)

  @@id([day, deviceId])
  @@map("ai_usage")
}

/// A long PDF report (natal chart, or transits now → 24 months), assembled in
/// the background. The app renders `data` into a PDF on the device.
model Report {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String
  kind      String // 'natal' | 'transit'
  status    String   @default("queued") // queued | running | ready | failed
  progress  Int      @default(0)
  total     Int      @default(0)
  stage     String?
  locale    String
  name      String
  data      Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, createdAt])
  @@map("reports")
}
