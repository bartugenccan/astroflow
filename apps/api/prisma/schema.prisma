generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──── Enums ──────────────────────────────────────────────────────────────────

enum FeatureType {
  TRANSIT_CHART
  COMPATIBILITY
  DEEP_INSIGHT
  PREMIUM_RITUAL
  ADVANCED_CYMATICS
}

enum InterpretationKind {
  PLACEMENT
  BIG_THREE
  ASPECT
  OVERVIEW
  DAILY_INSIGHT
  HOUSE
  NODES
  CHART_CONTEXT
  TRANSIT
  TRANSIT_OVERVIEW
  COMPATIBILITY
  FORECAST_WEEKLY
  FORECAST_MONTHLY
  GUIDANCE
  INTENTION_AFFIRMATION
  YEAR_AHEAD
  TAROT_CARD
  TAROT_SYNTHESIS
  ELECTION_CHECK
  ELECTION_SEARCH
  REPORT_NATAL_EXTRAS
  TRANSIT_SPOTLIGHT
  TRANSIT_QUARTER
}

// ──── Anonymous (device-ID) chart + AI interpretation cache ──────────────────

model DeviceChart {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String   @unique

  birthDate   String
  birthTime   String
  latitude    Float
  longitude   Float
  utcOffsetMin Int?
  unknownTime Boolean  @default(false)

  sunSign     String
  moonSign    String
  risingSign  String
  chartData   Json

  /// Display-only profile fields, so a sign-in on a new phone restores them.
  displayName String?
  placeName   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("device_charts")
}

model Interpretation {
  id         String             @id @default(uuid()) @db.Uuid
  cacheKey   String             @unique
  kind       InterpretationKind
  locale     String
  content    Json
  model      String?
  /// Set when the cached reading is specific to one device (tarot, daily insight,
  /// guidance) so deleting that device's data can delete it too.
  deviceId   String?

  createdAt  DateTime           @default(now())

  @@index([kind, locale])
  @@index([deviceId])
  @@map("interpretations")
}

// Device-scoped entitlement mirror of UnlockedFeature. The anonymous flow has no
// User, so per-report unlocks (e.g. COMPATIBILITY) are keyed by deviceId instead.
model DeviceUnlockedFeature {
  id          String      @id @default(uuid()) @db.Uuid
  deviceId    String
  featureType FeatureType
  unlockedAt  DateTime    @default(now())

  @@unique([deviceId, featureType])
  @@index([deviceId])
  @@map("device_unlocked_features")
}

// ──── Companion: memory + conversation ───────────────────────────────────────

// Device-scoped memory of what the user tells us, so every surface feels
// continuous ("last week work was heavy…"). Read as a compact digest into prompts.
model MemoryEntry {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String
  kind      String   // 'chat' | 'checkin' | 'topic' | 'goal' | 'fact'
  text      String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
  @@map("memory_entries")
}

// Conversational companion turns (device-scoped, anonymous).
model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String
  role      String   // 'user' | 'assistant'
  content   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
  @@map("chat_messages")
}

// ──── Intentions: chart-guided daily practice ────────────────────────────────

model Intention {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String

  goalText    String
  category    String
  lifeArea    String   // 'love' | 'career' | 'money' | 'energy'
  affirmation String
  dailyTarget Int      @default(1)
  status      String   @default("active") // 'active' | 'archived' | 'manifested'
  manifestedAt DateTime?
  /// Lunar refKey (peak date) of the new moon the wish waits for; null = planted now.
  plantedMoon String?
  /// Natal house the wish's life area lives in (love 7, career 10, money 2, energy 1).
  natalHouse  Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checkIns    IntentionCheckIn[]
  streak      IntentionStreak?

  @@index([deviceId])
  @@map("intentions")
}

model IntentionCheckIn {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String
  intentionId String   @db.Uuid

  date        String   // YYYY-MM-DD
  conviction  Int
  userText    String?
  inputMode   String   @default("text") // 'text' | 'voice'  (voice-ready)
  transcript  String?
  aiResponse  String
  aiConviction Int?

  createdAt   DateTime @default(now())

  intention   Intention @relation(fields: [intentionId], references: [id], onDelete: Cascade)

  @@index([intentionId, date])
  @@map("intention_check_ins")
}

model IntentionStreak {
  id             String   @id @default(uuid()) @db.Uuid
  deviceId       String
  intentionId    String   @unique @db.Uuid

  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String? // YYYY-MM-DD
  totalCheckIns  Int      @default(0)
  /// Missed days bridged by an Aster streak shield (YYYY-MM-DD strings).
  shieldUsedDates Json    @default("[]")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  intention      Intention @relation(fields: [intentionId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("intention_streaks")
}

// ─── Aster, the growing star mascot ─────────────────────────────────────────
// One row per subject. Işık (xp) never decreases and decides the stage;
// Yıldız Tozu (stardust) is the spendable balance. Stage is a cache of
// stageFor(xp) once the egg has hatched (first intention).
model MascotState {
  deviceId           String    @id
  xp                 Int       @default(0)
  stardust           Int       @default(0)
  stage              Int       @default(0)
  equipped           Json      @default("[]") // accessory ids, one per slot
  owned              Json      @default("[]") // accessory ids bought
  shields            Int       @default(0)    // streak shields in stock
  lastFreeShieldWeek String?                  // ISO week of the last free shield, "2026-W45"
  hatchedAt          DateTime?

  // Orbit: the device-wide "I showed up" streak (any award counts the day).
  orbitStreak        Int       @default(0)
  orbitBest          Int       @default(0)
  orbitLastDate      String?                  // YYYY-MM-DD, local
  journeysCompleted  Int       @default(0)
  // Eclipse: a chosen rest. Days inside [start, end] never break a streak.
  eclipseStart       String?                  // YYYY-MM-DD, local
  eclipseEnd         String?                  // YYYY-MM-DD, local, inclusive

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("mascot_states")
}

// Every positive action that fed Aster. The unique key makes awards
// idempotent and enforces daily caps (refKey is a slot number for capped
// repeatable kinds, or the intention / milestone / moon-phase id).
model MascotEvent {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String
  kind      String   // INTENTION_CREATE | CHECKIN | DAY_COMPLETE | MILESTONE | SKY_READ | AFFIRMATION | TAROT | MOON_RITUAL | EVENING_REFLECTION | BREATH
  localDate String   // YYYY-MM-DD in the user's zone (x-tz)
  refKey    String   @default("")
  xp        Int
  createdAt DateTime @default(now())

  @@unique([deviceId, kind, localDate, refKey])
  @@index([deviceId, localDate])
  @@index([deviceId, kind, refKey])
  @@map("mascot_events")
}

// Aster's cosmic journey: launched once a day when energy is high, back a few
// hours later with one transit discovery and a constellation. Resolved on read.
model MascotJourney {
  id               String    @id @default(uuid()) @db.Uuid
  deviceId         String
  localDate        String
  startedAt        DateTime  @default(now())
  returnsAt        DateTime
  claimedAt        DateTime?
  /// { transitPlanet, aspect, natalPoint, orb, sign, title, body, link }
  discovery        Json
  constellationKey String
  duplicate        Boolean   @default(false)
  bonusStardust    Int       @default(0)

  @@unique([deviceId, localDate])
  @@index([deviceId])
  @@map("mascot_journeys")
}

model MascotConstellation {
  id           String   @id @default(uuid()) @db.Uuid
  deviceId     String
  key          String
  count        Int      @default(1)
  firstFoundAt DateTime @default(now())

  @@unique([deviceId, key])
  @@map("mascot_constellations")
}

// The morning "how is your sky?" check-in. Labels only — free text never
// leaves the device.
enum MoodSky {
  RADIANT
  CLEAR
  PARTLY
  CLOUDY
  STORMY
}

model MoodCheckIn {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String
  localDate String
  sky       MoodSky
  energy    Int      // 1–5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, localDate])
  @@map("mood_checkins")
}

// The personal sky plan for one local day, built from the natal chart and
// today's transits. Rebuilt when the day's mood changes.
model DailyPlan {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String
  localDate String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, localDate])
  @@map("daily_plans")
}

// Encrypted backup of what the app otherwise keeps on the device
// (reflections, affirmations, tarot and election notes). Signed-in subjects
// only; sealed with a server key (encryption at rest), never sent to the AI.
model UserVault {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String
  namespace String   // 'reflections' | 'affirmations' | 'tarot' | 'election'
  sealed    String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([deviceId, namespace])
  @@map("user_vaults")
}

// A second person a device has entered for compatibility checks. Big-three is
// denormalized so the list renders without recomputing the chart.
model SavedPerson {
  id           String   @id @default(uuid()) @db.Uuid
  deviceId     String

  label        String
  relationship String?

  birthDate    String
  birthTime    String
  latitude     Float
  longitude    Float
  unknownTime  Boolean  @default(false)
  placeName    String?

  sunSign      String
  moonSign     String
  risingSign   String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([deviceId, createdAt])
  @@map("saved_people")
}

// ─── Device identity & cost guards ───────────────────────────────────────────

/// An install. Its id is issued (or, once, claimed) by POST /auth/device and
/// travels as the `did` claim of a signed device token.
///
/// `subjectId` is whose data the install works on — the `sub` claim, and the
/// value every `deviceId` column in this schema holds. A fresh install is its
/// own subject (null = same as deviceId). Signing in to an account on another
/// install points that install at the account's subject.
model DeviceIdentity {
  deviceId  String    @id
  subjectId String?
  createdAt DateTime  @default(now())
  /// Set on logout or data deletion — the install's token stops working.
  revokedAt DateTime?

  @@index([subjectId])
  @@map("device_identities")
}

// ─── Accounts (optional, linked to an anonymous subject) ─────────────────────

enum AuthProvider {
  APPLE
  GOOGLE
  EMAIL
}

/// A durable identity a user can sign in to from any install. It owns exactly
/// one subject; linking never moves data, it pins the current subject.
model Account {
  id          String    @id @default(uuid()) @db.Uuid
  subjectId   String    @unique
  displayName String?
  createdAt   DateTime  @default(now())

  identities AuthIdentity[]

  @@map("accounts")
}

/// One way to sign in to an account. `providerSubject` is Apple/Google `sub`,
/// or the lower-cased address for EMAIL. Accounts are never merged by email.
model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  accountId       String       @db.Uuid
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider        AuthProvider
  providerSubject String
  email           String?
  emailVerified   Boolean      @default(false)
  /// Sign in with Apple refresh token (AES-256-GCM), needed to revoke on deletion.
  appleRefreshTokenEnc String?
  createdAt       DateTime     @default(now())

  @@unique([provider, providerSubject])
  @@unique([accountId, provider])
  @@map("auth_identities")
}

/// A one-time sign-in code sent by email. Only a hash of the code is stored.
model EmailOtp {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("email_otps")
}

/// AI generations that missed the cache, per UTC day. `deviceId = "*"` is the
/// system-wide counter. Backs the daily per-device and global AI budgets.
model AiUsage {
  day      String // "YYYY-MM-DD" (UTC)
  deviceId String
  count    Int    @default(0)

  @@id([day, deviceId])
  @@map("ai_usage")
}

/// Per-subject daily allowances for metered features (e.g. "report"), keyed by
/// UTC day. Only ever incremented: deleting what was made does not refund it.
model DailyQuota {
  day      String // "YYYY-MM-DD" (UTC)
  deviceId String
  feature  String
  count    Int    @default(0)

  @@id([day, deviceId, feature])
  @@index([deviceId])
  @@map("daily_quotas")
}

/// A long PDF report (natal chart, or transits now → 24 months), assembled in
/// the background. The app renders `data` into a PDF on the device.
model Report {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String
  kind      String // 'natal' | 'transit'
  status    String   @default("queued") // queued | running | ready | failed
  progress  Int      @default(0)
  total     Int      @default(0)
  stage     String?
  locale    String
  name      String
  data      Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, createdAt])
  @@map("reports")
}

/// Pre-launch waitlist sign-ups from the marketing site. Not tied to a device;
/// removal requests come through the support email.
model WaitlistEntry {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  locale    String
  source    String?
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}
