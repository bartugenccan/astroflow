generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──── Enums ──────────────────────────────────────────────────────────────────

enum EnergyState {
  HARMONY
  MOMENTUM
  STRESS
  OVERLOAD
}

enum RitualType {
  WATER_PROGRAMMING
  KINETIC_SYNC
  BREATHWORK
  GROUNDING
  LIGHT_EXPOSURE
  FREQUENCY_TUNING
}

enum SynergyLevel {
  ALPHA
  BETA
  GAMMA
  DELTA
  OMEGA
}

enum FeatureType {
  TRANSIT_CHART
  COMPATIBILITY
  DEEP_INSIGHT
  PREMIUM_RITUAL
  ADVANCED_CYMATICS
}

// ──── Core Models ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String
  displayName   String
  avatarUrl     String?
  timezone      String    @default("Europe/Istanbul")
  starPoints    Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  birthProfile    BirthProfile?
  streaks         UserStreak[]
  ritualLogs      RitualLog[]
  unlockedFeatures UnlockedFeature[]

  @@map("users")
}

model BirthProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid

  birthDate    DateTime @db.Date
  birthTime    String
  latitude     Float
  longitude    Float

  sunSign      String
  moonSign     String
  risingSign   String
  risingDegree Float
  dominantElement String?
  dominantPlanet  String?

  chartData    Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("birth_profiles")
}

model UserStreak {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  ritualType      RitualType

  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastActiveDate  DateTime @db.Date
  totalCompletions Int     @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ritualType])
  @@map("user_streaks")
}

model RitualLog {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  ritualType   RitualType
  completedAt  DateTime   @default(now())
  frequencyBoost Int      @default(0)
  durationMinutes Int     @default(0)
  notes        String?

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("ritual_logs")
}

model FrequencyScore {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @unique @db.Uuid

  value        Int         @default(0)
  trend        String      @default("stable")
  synergyLevel SynergyLevel @default(ALPHA)

  breakdown    Json?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("frequency_scores")
}

model DailyAction {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid

  title          String
  description    String
  ritualType     RitualType
  energyCost     Int       @default(0)
  frequencyBoost Int       @default(0)
  durationMinutes Int      @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime?

  generatedAt    DateTime  @default(now())
  expiresAt      DateTime

  @@index([userId, completed, expiresAt])
  @@map("daily_actions")
}

model UnlockedFeature {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  featureType FeatureType
  unlockedAt  DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureType])
  @@map("unlocked_features")
}
